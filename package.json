{
  "name": "royaldent-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "build": "npm run sitemap && vite build && npm run spa:fallback && tsx scripts/build-server.ts",
    "start": "node --enable-source-maps server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"['dist','server.cjs','server.cjs.map'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit && npm run i18n:check && npm run doctors:check",
    "i18n:check": "npm run i18n:check:en && npm run i18n:check:lv",
    "i18n:check:en": "node scripts/check-english-coverage.mjs && tsx scripts/check-english-regressions.ts",
    "i18n:check:lv": "tsx scripts/check-latvian-coverage.ts && tsx scripts/check-latvian-regressions.ts",
    "doctors:check": "tsx scripts/check-doctor-publication.ts",
    "spa:fallback": "tsx scripts/spa-fallback.ts",
    "prices:reset": "tsx scripts/reset-prices.ts",
    "doctors:reset": "tsx scripts/reset-doctors.ts",
    "telegram:chat-id": "tsx scripts/telegram-chat-id.ts",
    "telegram:test": "tsx scripts/telegram-test-lead.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "@vis.gl/react-google-maps": "^1.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.40.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
