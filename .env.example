# APP_URL: публичный URL, на котором размещён сайт.
# Используется для абсолютных ссылок и API-эндпоинтов.
APP_URL="https://example.com"

# --- Altegio (alteg.io) онлайн-запись — только серверная часть ---
# Пока не заданы ОБА значения, форма записи использует реалистичные MOCK-данные.
# Partner token из маркетплейса Altegio:
#   https://app.alteg.io/appstore/developers/1
ALTEGIO_PARTNER_TOKEN=""
# Company (branch) id клиники в Altegio:
ALTEGIO_COMPANY_ID=""

# --- Telegram-уведомления о заявках — только серверная часть ---
# Пока не заданы ОБА значения, заявки просто пишутся в лог сервера.
# Токен бота из @BotFather (/mybots → бот → API Token):
TELEGRAM_BOT_TOKEN=""
# Id группы администраторов (отрицательное число, например -1001234567890).
# Узнать: заполнить токен выше, написать в группе /start@имя_бота
# и выполнить `npm run telegram:chat-id`.
TELEGRAM_CHAT_ID=""

# --- Панель администратора (/admin) ---
# Без этих переменных в dev действует временная пара admin/admin.
# На проде (NODE_ENV=production) сервер без них не стартует — см. src/server/env.ts.
ADMIN_LOGIN=""
ADMIN_PASSWORD=""

# Каталог файла базы SQLite. В dev по умолчанию ./storage, и этого достаточно.
# На проде ОБЯЗАТЕЛЕН и должен быть абсолютным: рабочий каталог там задаёт
# Passenger, и относительный путь увёл бы базу в неизвестное место.
# DB_DIR=""

# ВАЖНО: на проде все переменные задаются не этим файлом, а в панели Plesk
# (Websites & Domains → Node.js → custom environment variables). Подробнее —
# в README, раздел «Деплой».
