# APP_URL: публичный URL, на котором размещён сайт.
# Используется для абсолютных ссылок и API-эндпоинтов.
APP_URL="https://example.com"

# --- Google Maps / реальные отзывы ---
# Публичный браузерный ключ. Он попадёт в собранный JavaScript, поэтому в
# Google Cloud его обязательно ограничить доменами сайта и только Maps
# JavaScript API, Places API и Places API (New).
VITE_GOOGLE_MAPS_PLATFORM_KEY=""
# Place ID не является секретом и однозначно указывает на карточку клиники.
VITE_GOOGLE_PLACE_ID="ChIJmW83sRvd7kYRDQZdAt_PQfk"

# --- Telegram-уведомления о заявках — только серверная часть ---
# Пока не заданы ОБА значения, заявки просто пишутся в лог сервера.
# Токен бота из @BotFather (/mybots → бот → API Token):
TELEGRAM_BOT_TOKEN=""
# Id группы администраторов (отрицательное число, например -1001234567890).
# Узнать: заполнить токен выше, написать в группе /start@имя_бота
# и выполнить `npm run telegram:chat-id`.
TELEGRAM_CHAT_ID=""

# Случайная секретная строка для проверки запросов Telegram webhook.
# Понадобится для кнопки «Пациенту перезвонили». Не совпадает с токеном бота.
# Пример генерации: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=""

# Чат для технических уведомлений о сбоях: ошибки сервера, потерянные
# заявки, недоступная база. Отдельный от TELEGRAM_CHAT_ID намеренно —
# технический шум не должен перемешиваться с обращениями пациентов.
# Не задан — сбои только пишутся в лог сервера.
#
# ВАЖНО: отсюда нельзя узнать, что сайт упал целиком: мёртвый процесс
# ничего не отправит. Для этого нужен внешний монитор, дёргающий
# /api/health — UptimeRobot, Better Stack и подобные умеют слать в Telegram.
TELEGRAM_ALERT_CHAT_ID=""

# --- Панель администратора (/admin) ---
# Без этих переменных в dev действует временная пара admin/admin.
# На проде (NODE_ENV=production) сервер без них не стартует — см. src/server/env.ts.
ADMIN_LOGIN=""
ADMIN_PASSWORD=""

# Постоянный каталог приложения. В нём лежит не только файл базы SQLite, но и
# uploads/staff — фото сотрудников, загруженные через панель администратора.
# В dev по умолчанию ./storage, и этого достаточно.
# На проде ОБЯЗАТЕЛЕН, должен быть абсолютным и НАХОДИТЬСЯ ВНЕ КАТАЛОГА
# ПРИЛОЖЕНИЯ: рабочий каталог там задаёт Passenger, а деплой подменяет папку
# с кодом целиком — вместе с заявками и фотографиями, если они внутри неё.
# Бэкап делать со всего каталога, а не только с royaldent.db.
# DB_DIR=""

# ВАЖНО: на проде все переменные задаются не этим файлом, а в панели Plesk
# (Websites & Domains → Node.js → custom environment variables). Подробнее —
# в README, раздел «Деплой».
